{
    "manifest_version": 3,
    "name": "What's My Tab?",
    "version": "1.0",
    "description": "Will add more.",
    "permissions": [
        "tabs",
        "storage",
        "sidePanel"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_title": "I don't know my tab...",
        "default_icon": {
            "16": "resources/short_logo.png",
            "48": "resources/short_logo.png",
            "128": "resources/short_logo.png"
        }
    },
    "icons": {
        "16": "resources/short_logo.png",
        "48": "resources/short_logo.png",
        "128": "resources/short_logo.png"
    },
    "side_panel": {
        "default_path": "wmt.html"
    }
}